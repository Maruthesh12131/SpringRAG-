# Spring Boot backend used by the Vite dev server proxy (npm run dev).
VITE_BACKEND_URL=http://localhost:8080

# Base URL the browser calls. Leave empty to use same-origin /api
# (dev proxy, or when the frontend is served behind the same host as the API).
# If set to a different origin, the backend must allow that origin via CORS.
VITE_API_BASE_URL=
